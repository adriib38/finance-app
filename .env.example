# Copia este fichero a .env en la raíz del repo y rellena los valores.
# Lo usa docker-compose.yml para levantar la base de datos y el backend juntos.
# El .env real está gitignoreado.

# --- Base de datos (contenedor MariaDB) ---
DB_DATABASE=finance
DB_USER=finance
DB_PASSWORD=finance
DB_ROOT_PASSWORD=finance
# Puerto expuesto en el host (útil si ya tienes algo en el 3306 local)
DB_PORT=3306

# --- Backend ---
PORT=4000
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
SALT_ROUNDS=10

# --- Cuenta única (se siembra/sincroniza en cada arranque) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# --- Bot IA (Feature 7 — endpoint POST /api/v1/ai/ask) ---
# Si OPENAI_API_KEY no está, ese endpoint responde 503 y el resto de la API funciona igual.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# Usuario MySQL de SOLO LECTURA para la tool consultar_bd (recomendado en producción).
DB_RO_USER=
DB_RO_PASSWORD=
