# Copia este fichero a .env y rellena los valores.
# El .env real está gitignoreado.

# --- Servidor ---
PORT=4000

# --- Base de datos (MySQL / MariaDB) ---
DB_HOST=localhost
DB_USER=finance
DB_PASSWORD=finance
DB_DATABASE=finance

# --- Auth ---
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
SALT_ROUNDS=10

# --- Cuenta única (se siembra/sincroniza en cada arranque) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# --- Bot IA (Feature 7 — endpoint POST /api/v1/ai/ask) ---
# Si OPENAI_API_KEY no está, ese endpoint responde 503 y el resto de la API funciona igual.
OPENAI_API_KEY=
# Modelo del bot (por defecto gpt-4o-mini). Alternativa: gpt-4o
AI_MODEL=gpt-4o-mini
# Usuario MySQL de SOLO LECTURA para la tool consultar_bd. Recomendado en producción.
# Si no se define, la tool usa DB_USER (con permisos de escritura) y avisa por consola.
#   CREATE USER 'finance_ro'@'%' IDENTIFIED BY '<pass>';
#   GRANT SELECT ON finance.* TO 'finance_ro'@'%';
DB_RO_USER=
DB_RO_PASSWORD=
