        {
          "name": "Timeline (balance mensual)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stats/timeline?from=2026-01-01&to=2026-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stats", "timeline"],
              "query": [
                { "key": "from", "value": "2026-01-01", "description": "YYYY-MM-DD (opcional)" },
                { "key": "to", "value": "2026-12-31", "description": "YYYY-MM-DD (opcional)" }
