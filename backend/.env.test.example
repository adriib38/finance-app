# Copia este fichero a .env.test y ajústalo si hace falta.
# El .env.test real está gitignoreado.
#
# Plantilla para el ENTORNO DE PRUEBAS: apunta a un segundo contenedor de BD
# (finance-db-test) totalmente separado del de producción, para poder
# desarrollar sin riesgo de tocar datos reales. Ver README.md § "Entorno de
# pruebas" en la raíz del repo para el flujo completo (crear el contenedor,
# `npm run start:test`, `scripts/start-test.sh`).

# --- Servidor ---
PORT=4001

# --- Base de datos (contenedor finance-db-test, puerto 3307) ---
DB_HOST=localhost
DB_PORT=3307
DB_USER=finance_test
DB_PASSWORD=finance_test
DB_DATABASE=finance_test

# --- Auth ---
JWT_SECRET=test-jwt-secret-no-usar-en-produccion
SALT_ROUNDS=10

# --- Cuenta única (se siembra/sincroniza en cada arranque) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-test-1234

# --- Bot IA (opcional en test; déjalo vacío si no quieres gastar cuota) ---
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
DB_RO_USER=
DB_RO_PASSWORD=

# --- CORS: el frontend de pruebas corre en el puerto 3007 ---
ALLOWED_ORIGINS=http://localhost:3007
